<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section
    id="email-verification-status"
    aria-labelledby="email-verification-title"
    class="mx-auto w-full max-w-md space-y-6 py-12 text-center"
  >
    <.icon name="hero-envelope" class="mx-auto size-10 text-primary" />
    <h1 id="email-verification-title" class="text-2xl font-semibold">
      {gettext("Verify your email to sign in")}
    </h1>
    <p class="text-base-content/80">
      {gettext(
        "We sent you a one-time link. Follow the instructions in your email to confirm your account and sign in."
      )}
    </p>
    <p class="text-sm text-base-content/60">
      {gettext("If you cannot find it, check your spam folder or request a new sign-in link.")}
    </p>
    <.link
      id="verification-back-to-login"
      href={DailyLogosWeb.LocalePaths.localized_path(~p"/users/log-in", @locale)}
      class="inline-flex min-h-11 items-center gap-2 font-semibold underline"
    >
      <.icon name="hero-arrow-left" class="size-4" />
      {gettext("Back to log in")}
    </.link>
  </section>
</Layouts.app>
