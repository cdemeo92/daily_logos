<Layouts.app flash={@flash}>
  <div class="min-h-[60vh] flex flex-col items-center justify-center py-12">
    <div class="w-full text-center space-y-6">
      <header class="space-y-2">
        <% months = [
          gettext("January"),
          gettext("February"),
          gettext("March"),
          gettext("April"),
          gettext("May"),
          gettext("June"),
          gettext("July"),
          gettext("August"),
          gettext("September"),
          gettext("October"),
          gettext("November"),
          gettext("December")
        ] %>
        <% month_name = Enum.at(months, @month - 1) %>
        <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-balance">
          {@quote_topic}
        </h1>
        <% locale_prefix = if @locale == "en", do: "", else: "/#{@locale}" %>
        <% date = Date.new!(2023, @month, @day) %>
        <% prev = Date.add(date, -1) %>
        <% next = Date.add(date, 1) %>
        <div class="flex items-center justify-between">
          <.link
            navigate={"#{locale_prefix}/#{prev.month}/#{prev.day}"}
            class="inline-flex items-center gap-1 text-sm text-base-content/50 hover:text-base-content transition-colors"
            aria-label={gettext("Previous day")}
          >
            <.icon name="hero-arrow-left" class="size-4" />
            {gettext("Previous")}
          </.link>
          <time
            datetime={"#{@month}-#{String.pad_leading(to_string(@day), 2, "0")}"}
            class="text-base font-semibold text-amber-600 dark:text-amber-400"
          >
            {month_name} {@day}
          </time>
          <.link
            navigate={"#{locale_prefix}/#{next.month}/#{next.day}"}
            class="inline-flex items-center gap-1 text-sm text-base-content/50 hover:text-base-content transition-colors"
            aria-label={gettext("Next day")}
          >
            {gettext("Next")}
            <.icon name="hero-arrow-right" class="size-4" />
          </.link>
        </div>
      </header>

      <%!-- Decorative opening quotation mark --%>
      <div class="mb-1 flex justify-center text-6xl opacity-15">
        "
      </div>

      <div id="daily-quote">
        <%!-- Quote text --%>
        <p class="text-2xl md:text-3xl font-serif italic leading-relaxed text-balance">
          {@quote_text}
        </p>

        <%!-- Separator line --%>
        <div class="flex justify-center">
          <div class="w-12 h-1 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full"></div>
        </div>

        <%!-- Author --%>
        <div>
          <p class="text-lg font-medium">{@quote_author}</p>
          <p class="text-sm uppercase tracking-wide opacity-60 mt-1">{@quote_source}</p>
        </div>
      </div>

      <div>
        <.link
          navigate={~p"/"}
          class="inline-flex items-center gap-1.5 text-sm text-base-content/60 hover:text-base-content transition-colors"
        >
          <.icon name="hero-arrow-left" class="size-4" />
          {gettext("Today's quote")}
        </.link>
      </div>
    </div>
  </div>
</Layouts.app>
